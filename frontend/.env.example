# Local: call the API directly.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production (Vercel): NEXT_PUBLIC_API_URL=/ and API_PROXY_TARGET=<Render API origin>
# so /api/* is proxied through this site. See docs/DEPLOYMENT.md.
# API_PROXY_TARGET=https://earnio-api.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
